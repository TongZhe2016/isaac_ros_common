# 轻量开发层：常用 pip 包（json5、open3d）。
# 不安装 Miniforge / conda / 完整 OmniStereo 训练栈；TensorRT C++/Python 由 NVIDIA Isaac ROS 基础镜像提供。
#
# 启用：CONFIG_IMAGE_KEY=ros2_humble.omnistereo（或 build_image_layers.sh -i ros2_humble.omnistereo）
#
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG PLATFORM=arm64
ENV PLATFORM=${PLATFORM}
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# Python deps used by OmniStereo scripts (e.g. infer_trt, visualization).
# open3d pulls dash/flask; base image has apt-installed blinker/click (distutils).
# pip cannot uninstall those — use --ignore-installed to overlay site-packages.
RUN python3 -m pip install --no-cache-dir --ignore-installed json5 open3d
